<Window x:Class="Shop_Shoe.OrderDetailsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Чудо Обувь - Детали заказа" Height="550" Width="850"
        Background="#FFFFFF" FontFamily="Calibri" WindowStartupLocation="CenterScreen">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,15" VerticalAlignment="Center">
            <TextBlock Text="Заказ №" FontSize="20" FontWeight="Bold" VerticalAlignment="Center"/>
            <TextBlock x:Name="OrderIdText" FontSize="20" FontWeight="Bold" VerticalAlignment="Center" Margin="5,0,20,0"/>
            <TextBlock Text="Дата заказа:" FontSize="16" VerticalAlignment="Center" Margin="0,0,10,0"/>
            <DatePicker x:Name="OrderDatePicker" Width="150" Height="30" VerticalAlignment="Center"/>
            <Button x:Name="SaveDateButton" Content="Сохранить дату" Click="SaveDateButton_Click" 
                    Width="140" Height="30" Background="#70B2AF" Foreground="White" FontWeight="Bold" 
                    BorderThickness="0" Margin="15,0,0,0" Visibility="Collapsed"/>
        </StackPanel>
        <DataGrid x:Name="DetailsDataGrid" Grid.Row="1" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True" RowHeaderWidth="0">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Товар" Binding="{Binding ProductName}" Width="*"/>
                <DataGridTextColumn Header="Размер" Binding="{Binding SizeName}" Width="80"/>
                <DataGridTextColumn Header="Кол-во" Binding="{Binding Quantity}" Width="80"/>
                <DataGridTextColumn Header="Цена" Binding="{Binding PricePerUnit, StringFormat={}{0} руб.}" Width="100"/>
                <DataGridTextColumn Header="Сумма" Binding="{Binding Total, StringFormat={}{0} руб.}" Width="120"/>
                <DataGridTemplateColumn x:Name="DeleteColumn" Header="Действие" Width="120" Visibility="Collapsed">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Button Content="Удалить" Click="DeleteItem_Click" Background="#FF8080" Foreground="White" BorderThickness="0" FontWeight="Bold" Padding="5,2"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</Window>