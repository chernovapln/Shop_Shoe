<Window x:Class="Shop_Shoe.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Чудо Обувь - Авторизация" Height="400" Width="500"
        Background="#FFFFFF" FontFamily="Calibri" WindowStartupLocation="CenterScreen" ResizeMode="NoResize">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Border Grid.Row="0" Background="#D2F6E7" Padding="20">
            <StackPanel HorizontalAlignment="Center">
                <Image Source="Images/Чудо Обувь.png" Height="80"/>
                <TextBlock Text="Вход в систему" FontSize="22" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,10,0,0"/>
            </StackPanel>
        </Border>
        <StackPanel Grid.Row="1" VerticalAlignment="Center" Margin="40">
            <TextBlock Text="Введите ваш логин:" FontSize="16" Margin="0,0,0,10"/>
            <TextBox x:Name="LoginTextBox" FontSize="16" Padding="5" Height="35" BorderBrush="Gray" BorderThickness="1"/>
            <TextBlock x:Name="ErrorTextBlock" Foreground="Red" FontSize="14" Margin="0,10,0,0" Visibility="Collapsed" TextWrapping="Wrap"/>
            <Button Content="Войти" Click="LoginButton_Click" Background="#70B2AF" Foreground="White" FontSize="18" FontWeight="Bold"
                    Height="45" Margin="0,20,0,0" BorderThickness="0" Cursor="Hand"/>
        </StackPanel>
    </Grid>
</Window>