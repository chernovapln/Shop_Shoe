<Window x:Class="Shop_Shoe.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Чудо Обувь - Каталог" Height="850" Width="1100"
        Background="#FFFFFF" FontFamily="Calibri" WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <Style x:Key="ProductNameStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="Black"/>
        </Style>
        <Style x:Key="LabelStyle" TargetType="Run">
            <Setter Property="Foreground" Value="Gray"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Background" Value="#70B2AF"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Шапка -->
        <Border Grid.Row="0" Background="#D2F6E7" Padding="15,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Image Source="Images/Чудо Обувь.png" Height="60" Grid.Column="0"/>
                <TextBlock Text="Каталог обуви" FontSize="26" FontWeight="Bold" VerticalAlignment="Center" Margin="20,0" Grid.Column="1"/>
                <TextBlock x:Name="UserNameTextBlock" VerticalAlignment="Center" FontSize="16" FontWeight="SemiBold" Grid.Column="2"/>
            </Grid>
        </Border>

        <!-- Фильтры -->
        <Border Grid.Row="1" Padding="20,10" BorderBrush="LightGray" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Margin="0,0,15,0">
                    <TextBlock Text="Поиск:" FontSize="12" Foreground="Gray"/>
                    <TextBox x:Name="SearchTextBox" Height="30" FontSize="14" TextChanged="SearchTextBox_TextChanged" Padding="5"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Margin="0,0,15,0">
                    <TextBlock Text="Категория:" FontSize="12" Foreground="Gray"/>
                    <ComboBox x:Name="CategoryComboBox" Width="180" Height="30" FontSize="14" SelectionChanged="CategoryComboBox_SelectionChanged"/>
                </StackPanel>
                <StackPanel Grid.Column="2" Margin="0,0,15,0">
                    <TextBlock Text="Сортировка:" FontSize="12" Foreground="Gray"/>
                    <ComboBox x:Name="SortComboBox" Width="180" Height="30" FontSize="14" SelectionChanged="SortComboBox_SelectionChanged">
                        <ComboBoxItem Content="Без сортировки" IsSelected="True"/>
                        <ComboBoxItem Content="По возрастанию цены"/>
                        <ComboBoxItem Content="По убыванию цены"/>
                    </ComboBox>
                </StackPanel>
                <StackPanel Grid.Column="3" VerticalAlignment="Bottom">
                    <Button x:Name="OrdersButton" Content="Заказы" Click="OrdersButton_Click" Height="30" Padding="15,0" Visibility="Collapsed"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Список товаров -->
        <ScrollViewer Grid.Row="2" Padding="20">
            <ItemsControl x:Name="ProductsList">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border BorderBrush="LightGray" BorderThickness="1" Margin="0,0,0,15" Background="{Binding BackgroundColor}" CornerRadius="4"
                                MouseLeftButtonUp="ProductBorder_MouseLeftButtonUp" Cursor="Hand">
                            <Grid Margin="10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="150"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Image Source="{Binding PicturePath}" Width="130" Height="130" Stretch="Uniform" Grid.Column="0"/>
                                <StackPanel Grid.Column="1" Margin="20,0" VerticalAlignment="Center">
                                    <TextBlock Style="{StaticResource ProductNameStyle}" Margin="0,0,0,10">
                                        <Run Text="{Binding ManufacturerName, Mode=OneWay}"/><Run Text=" | "/><Run Text="{Binding NameProduct, Mode=OneWay}"/>
                                    </TextBlock>
                                    <TextBlock FontSize="14" Margin="0,2"><Run Text="Категория: " Style="{StaticResource LabelStyle}"/><Run Text="{Binding CategoryName, Mode=OneWay}"/></TextBlock>
                                    <TextBlock FontSize="14" Margin="0,2"><Run Text="Количество: " Style="{StaticResource LabelStyle}"/><Run Text="{Binding QuantityStatus, Mode=OneWay}"/></TextBlock>
                                    <TextBlock TextWrapping="Wrap" FontSize="14" Margin="0,2"><Run Text="Состав: " Style="{StaticResource LabelStyle}"/><Run Text="{Binding Structure, Mode=OneWay}"/></TextBlock>
                                </StackPanel>
                                <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="10,0">
                                    <TextBlock FontSize="24" FontWeight="Bold" HorizontalAlignment="Right">
                                        <Run Text="{Binding FinalPrice, Mode=OneWay, StringFormat={}{0} руб.}"/>
                                    </TextBlock>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</Window>